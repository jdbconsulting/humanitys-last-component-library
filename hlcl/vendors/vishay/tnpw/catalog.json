				"kind": "select",
				"default_value": "vendor",
				"choices": [
					{
						"id": "vendor",
						"label": "Vendor-specific, e.g. RESC1608X55_TNPWN"
					},
					{
						"id": "generic",
						"label": "Generic IPC-7351B, e.g. RESC1608X55N"
					}
				]
			}
		},
		{
			"id": "terminations",
